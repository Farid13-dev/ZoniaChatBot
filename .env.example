# Copia este archivo a .env y rellena los valores.
# .env NUNCA se sube al repositorio (ver .gitignore).

# Token del panel de administracion
ADMIN_TOKEN=cambia-esto

# Groq: endpoint compatible con la API de OpenAI (console.groq.com)
# El YAML lo referencia como ${oc.env:GROQ_API_KEY,""}
GROQ_API_KEY=

# Host de Milvus. En local se deja vacio (por defecto localhost);
# en Docker debe ser el nombre del servicio: standalone
# MILVUS_HOST=standalone
# MILVUS_PORT=19530

# Modelo de Whisper para el ASR (opcional, ruta absoluta o relativa)
# WHISPER_MODEL=
