    "@types/node": "^18.18.0",
    "@types/recordrtc": "^5.6.14",
    "jasmine-core": "~5.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
