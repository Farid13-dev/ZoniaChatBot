{
  "name": "zonia-chat-bot",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:admin-chat": "node dist/admin-chat/server/server.mjs",
    "serve:ssr:user-chat": "node dist/user-chat/server/server.mjs",
    "start:user": "ng serve user-chat --port 4202",
    "start:admin": "ng serve admin-chat --port 4203",
    "build:user": "ng build user-chat",
    "build:admin": "ng build admin-chat"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
