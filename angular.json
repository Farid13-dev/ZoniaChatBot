{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "user-chat": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/user-chat",
      "sourceRoot": "projects/user-chat/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/user-chat",
            "index": "projects/user-chat/src/index.html",
            "browser": "projects/user-chat/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/user-chat/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/user-chat/src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "projects/user-chat/src/styles.css",
              "projects/user-chat/src/styles.css",
              "projects/user-chat/src/assets/css/Styles_Conversacion.css",
              "projects/user-chat/src/assets/css/normalize.css",
              "projects/user-chat/src/assets/fonts/font-awesome-4.2.0/css/font-awesome.min.css",
              "projects/user-chat/src/assets/css/demo.css",
              "projects/user-chat/src/assets/css/set1.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "projects/user-chat/src/styles.css"
            ],
            "scripts": [
              "projects/user-chat/src/assets/js/Script.js",
              "projects/user-chat/src/assets/js/classie.js"
            ],
            "server": "projects/user-chat/src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "projects/user-chat/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "user-chat:build:production"
            },
            "development": {
              "buildTarget": "user-chat:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/user-chat/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/user-chat/public"
              }
            ],
            "styles": [
              "projects/user-chat/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    },
    "admin-chat": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/admin-chat",
      "sourceRoot": "projects/admin-chat/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/admin-chat",
            "index": "projects/admin-chat/src/index.html",
            "browser": "projects/admin-chat/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/admin-chat/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin-chat/public"
              }
            ],
            "styles": [
              "projects/admin-chat/src/styles.css",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.snow.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css"
            ],
            "scripts": [],
            "server": "projects/admin-chat/src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "projects/admin-chat/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "admin-chat:build:production"
            },
            "development": {
              "buildTarget": "admin-chat:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/admin-chat/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin-chat/public"
              }
            ],
            "styles": [
              "projects/admin-chat/src/styles.css",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.snow.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
